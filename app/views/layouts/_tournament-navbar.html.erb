<% if @tournament and @tournament.id %>
<nav class="wd-navbar wd-navbar--default wd-navbar--fixed-top" role="navigation" id="tournament-navbar" data-controller="navbar-collapse">
  <div class="wd-container">
    <div class="wd-navbar__header">
      <button type="button" class="wd-navbar__toggle" data-navbar-collapse-target="toggle" data-action="navbar-collapse#toggle" aria-expanded="false" aria-controls="tournament-navbar-collapse">
        <span class="wd-sr-only">Toggle navigation</span>
        <span class="wd-navbar__icon-bar"></span>
        <span class="wd-navbar__icon-bar"></span>
        <span class="wd-navbar__icon-bar"></span>
      </button>
      <%= link_to "Tournament Menu", "/tournaments/#{@tournament.id}", class: "wd-navbar__brand" %>
    </div>
    <div id="tournament-navbar-collapse" class="wd-navbar__collapse wd-collapse" data-navbar-collapse-target="panel">
      <ul class="wd-navbar__nav wd-navbar__nav--right">
        <li><%= link_to " Home", "/tournaments/#{@tournament.id}", class: "wd-navbar__link fas fa-home" %></li>
        <% if can? :read, @tournament %>
          <li class="wd-dropdown" data-controller="dropdown">
            <a class="wd-navbar__link wd-dropdown__toggle" data-dropdown-target="toggle" data-action="click->dropdown#toggle" href="#" aria-expanded="false"><i class="fas fa-poll-h"> Results/Brackets</i>
            <span class="wd-caret"></span></a>
            <ul class="wd-dropdown__menu">
              <li><strong>Results</strong></li>
              <li><%= link_to "Team Scores", "/tournaments/#{@tournament.id}/team_scores" %></li>
              <li><%= link_to "All Match Results", "/tournaments/#{@tournament.id}/all_results" %></li>
              <li><strong>Brackets</strong></li>
              <% @tournament.weights.sort_by{|weight| weight.max }.each do |weight| %>
                <li><%= link_to "#{weight.max}", "/tournaments/#{@tournament.id}/brackets/#{weight.id}" %></li>
              <% end %>
              <li><%= link_to "All Brackets (Printable)", "/tournaments/#{@tournament.id}/all_brackets?print=true", target: :_blank %></li>
            </ul>
          </li>
          <li><%= link_to " Bout Board", "/tournaments/#{@tournament.id}/up_matches", class: "wd-navbar__link fas fa-list-alt" %></li>
          <li><%= link_to " Live Scores", "/tournaments/#{@tournament.id}/live_scores", class: "wd-navbar__link fas fa-tv" %></li>
        <% end %>
        <% if can? :manage, @tournament %>
          <li><%= link_to " Director Links", director_tournament_path(@tournament), class: "wd-navbar__link fas fa-tools" %></li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
<% end %>
