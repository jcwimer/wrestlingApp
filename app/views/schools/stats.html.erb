<% back_to_school_path = school_path(@school) %>
<% back_to_school_path += "?school_permission_key=#{params[:school_permission_key]}" if params[:school_permission_key].present? %>

<%= link_to "Back to #{@school.name}", back_to_school_path, class: "btn btn-default" %>
<% cache TournamentCacheInvalidator.school_stats_key(@school.id), skip_digest: true do %>
  <br>
  <br>
  <h2><%= @school.name %> Stats Summary</h2>
  <br>
  <h4>Matches</h4>
  <br>
  <table class="table">
    <thead>
      <tr>
        <th>Wrester</th>
        <th>Weight Class</th>
        <th>Bout</th>
        <th>Match Bracket Position</th>
        <th>Stats</th>
        <th>Result</th>
      </tr>
    </thead>
    <tbody>
      <% @school_stats_rows.each do |row| %>
          <tr>
            <td><%= row[:wrestler_name] %></td>
            <td><%= row[:weight] %></td>
            <td><%= row[:bout_number] %></td>
            <td><%= row[:bracket_position] %></td>
            <td>
              <table class="table table-sm table-bordered">
                
                <tbody>
                  <tr>
                    <td><%= row[:w1_name].html_safe %></td>
                    <td><%= row[:w1_stat] %></td>
                  </tr>
                  <tr>
                    <td><%= row[:w2_name].html_safe %></td>
                    <td><%= row[:w2_stat] %></td>
                  </tr>
                </tbody>
              </table>
            </td>
            <td><%= row[:result] %>
          </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
