<% cache TournamentCacheInvalidator.team_scores_key(@tournament.id), skip_digest: true do %>
  <table class="pagebreak table table-striped table-bordered">
  <h3>Team Scores</h3>
    <thead>
      <tr>
        <th>Name</th>
        <th>Score</th>
      </tr>
    </thead>
  
    <tbody>
      <% @team_scores.each_with_index do |school, index| %>
        <tr>
          <td><%= index + 1 %>. <%= school[:name] %> (<%= school[:abbreviation] %>)</td>
          <td><%= school[:score] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
