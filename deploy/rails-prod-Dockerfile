FROM ruby:4.0.5-alpine3.24 AS base

WORKDIR /rails

RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates curl libstdc++ mariadb-connector-c tzdata

ENV RAILS_ENV=production \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT=development:test:doc \
    SOLID_QUEUE_IN_PUMA=true \
    MARIADB_TLS_DISABLE_PEER_VERIFICATION=1

FROM base AS build

RUN apk add --no-cache build-base mariadb-connector-c-dev openssl-dev pkgconf yaml-dev

COPY Gemfile Gemfile.lock ./
RUN gem install bundler --version 4.0.3 --no-document \
    && bundle install --jobs 4 \
    && rm -rf /usr/local/bundle/cache /usr/local/bundle/ruby/*/cache

COPY . .
RUN WRESTLINGDEV_SECRET_KEY_BASE=assets-precompile-only bin/rails assets:precompile

FROM base AS production

RUN addgroup -g 1000 rails \
    && adduser -D -u 1000 -G rails rails

COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /rails/Gemfile /rails/Gemfile.lock /rails/Rakefile /rails/config.ru ./
COPY --from=build /rails/app ./app
COPY --from=build /rails/bin ./bin
COPY --from=build /rails/config ./config
COPY --from=build /rails/db ./db
COPY --from=build /rails/lib ./lib
COPY --from=build /rails/public ./public
COPY --from=build /rails/vendor ./vendor

RUN mkdir -p db log storage tmp/pids \
    && chown -R rails:rails db log storage tmp

USER rails:rails

EXPOSE 3000
CMD ["bundle", "exec", "rails", "server", "-e", "production", "-p", "3000", "-b", "0.0.0.0"]
